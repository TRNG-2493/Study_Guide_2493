{
  "$comment": "Anatomy manifest of YOUR RequirementReviewer agent. Same shape as the demo's demo_agent_anatomy.json. Paths are relative to the repository root. Check it with: python design_lab.py dissect",
  "manifest_version": "1.0.0",
  "agent": {
    "name": "RequirementReviewer",
    "version": "1.0.0",
    "contract_version": "1.0.0",
    "owner": "TODO (pair names)",
    "job": "TODO: one sentence, no 'and'",
    "autonomy": "TODO: assistant | workflow | autonomous",
    "autonomy_note": "TODO: why",
    "loop": [
      "perceive",
      "reason",
      "act",
      "check"
    ]
  },
  "parts": [
    {
      "id": "model",
      "name": "Model (LLM)",
      "job": "Reads text and writes text. The only non-deterministic part. Kept swappable.",
      "lives_in": "config: Claude, the organisation-approved model",
      "file": null,
      "owner": "TODO",
      "guards": [
        "C->D"
      ],
      "lesson": "agent-architecture.md section 3 (item 1)",
      "built": "today: you paste into Claude"
    },
    {
      "id": "instructions",
      "name": "Instructions (system message)",
      "job": "Standing orders: role, goal, scope, process, rules, output, uncertainty, boundaries, style. Same every run.",
      "lives_in": "system message",
      "file": "agent/instructions.md",
      "owner": "TODO",
      "guards": [
        "C"
      ],
      "lesson": "agent-instructions.md sections 4 and 5",
      "built": "today"
    },
    {
      "id": "prompt_template",
      "name": "Prompt template (user message)",
      "job": "Fixed wording plus $placeholders filled with this story's data. Says 'here is today's job'.",
      "lives_in": "user message",
      "file": "agent/templates/rr_user_v1.0.0.txt",
      "owner": "TODO",
      "guards": [
        "B->C"
      ],
      "lesson": "prompt-templates.md sections 4 and 7",
      "built": "today"
    },
    {
      "id": "input_contract",
      "name": "Input contract (preconditions)",
      "job": "What the agent accepts. Bad input is rejected before a model call is paid for.",
      "lives_in": "JSON Schema, Draft 2020-12",
      "file": "agent/schemas/rr_input.schema.json",
      "owner": "TODO",
      "guards": [
        "A"
      ],
      "lesson": "input-output-contracts.md sections 7 and 9.2",
      "built": "today"
    },
    {
      "id": "output_contract",
      "name": "Output contract (postconditions)",
      "job": "What the agent returns: shape, types, patterns, enums, a version and an honest 'I can't' path.",
      "lives_in": "JSON Schema, Draft 2020-12",
      "file": "agent/schemas/rr_output.schema.json",
      "owner": "TODO",
      "guards": [
        "E"
      ],
      "lesson": "input-output-contracts.md section 9, json-schema.md section 12",
      "built": "today"
    },
    {
      "id": "validation_rules",
      "name": "Validation rules (rule catalogue)",
      "job": "Rules a schema cannot see because they compare output with input: R1-R6, plus quality warnings Q1-Q3.",
      "lives_in": "rule catalogue; code on Friday",
      "file": "agent/rules.md",
      "owner": "TODO",
      "guards": [
        "E-semantic"
      ],
      "lesson": "required-fields-and-validation-rules.md sections 7 and 9",
      "built": "today: catalogue + R2, R4, R6 examples; full script Friday"
    },
    {
      "id": "validation_gate",
      "name": "Validation gate",
      "job": "Applies input schema, output schema and rules to every run. Rejects, never silently passes on.",
      "lives_in": "the runtime",
      "file": null,
      "owner": "TODO",
      "guards": [
        "A",
        "E",
        "E-semantic"
      ],
      "lesson": "agent-architecture.md section 3 (item 6)",
      "built": "Friday (building-validation-scripts.md)"
    },
    {
      "id": "tools",
      "name": "Tools",
      "job": "Functions the agent may call. RequirementReviewer has none on purpose: the story is handed to it.",
      "lives_in": "tool definitions",
      "file": null,
      "owner": "TODO",
      "guards": [],
      "lesson": "agent-architecture.md section 3 (item 7)",
      "built": "concept only",
      "items": []
    },
    {
      "id": "context_memory",
      "name": "Context and memory",
      "job": "Context = instructions + rendered template. Memory = nothing. Every run starts fresh, so it is easy to test.",
      "lives_in": "the runtime",
      "file": null,
      "owner": "TODO",
      "guards": [],
      "lesson": "agent-architecture.md section 3 (item 8)",
      "built": "concept only (stateless)"
    },
    {
      "id": "orchestration",
      "name": "Orchestration runtime",
      "job": "Runs the loop: check input, render, call model, parse, validate, hand to a human, log.",
      "lives_in": "runtime.py",
      "file": null,
      "owner": "TODO",
      "guards": [
        "B",
        "D"
      ],
      "lesson": "agent-architecture.md sections 8 and 12",
      "built": "Friday (anatomy_lab.py shows the pieces separately today)"
    },
    {
      "id": "logs",
      "name": "Logs",
      "job": "One record per run: versions of instructions, template and contract, sizes, errors, timings.",
      "lives_in": "logs/requirement_reviewer/",
      "file": null,
      "owner": "TODO",
      "guards": [
        "whole run"
      ],
      "lesson": "agent-architecture.md section 3 (item 10)",
      "built": "Friday"
    },
    {
      "id": "sample_pairs",
      "name": "Sample input/output pairs",
      "job": "Reviewed worked examples: spec by example, few-shot, golden regression data, contract test data.",
      "lives_in": "agent/samples/",
      "file": "agent/samples",
      "owner": "TODO",
      "guards": [
        "over time"
      ],
      "lesson": "sample-input-output-pairs.md sections 2 and 5",
      "built": "today"
    },
    {
      "id": "human_reviewer",
      "name": "Human reviewer",
      "job": "Judges meaning: correct, complete, grounded. Signs off. Accountable; the AI never is.",
      "lives_in": "review record / correction log (Wednesday)",
      "file": null,
      "owner": "TODO",
      "guards": [
        "F"
      ],
      "lesson": "human-validation-of-ai-output.md (Wednesday)",
      "built": "Wednesday"
    }
  ],
  "boundaries": [
    {
      "id": "A",
      "between": "caller -> input check",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "input_contract"
    },
    {
      "id": "B->C",
      "between": "trusted data -> prompt assembly",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "prompt_template (substitute, not safe_substitute)"
    },
    {
      "id": "C",
      "between": "instructions -> model",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "instructions"
    },
    {
      "id": "D",
      "between": "model -> raw text",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "instructions (Output) + parse step"
    },
    {
      "id": "E",
      "between": "parsed object -> gate",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "output_contract"
    },
    {
      "id": "E-semantic",
      "between": "parsed object vs input",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "validation_rules"
    },
    {
      "id": "F",
      "between": "contract-valid output -> suite",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "human_reviewer"
    },
    {
      "id": "whole run",
      "between": "yesterday vs today",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "logs"
    },
    {
      "id": "over time",
      "between": "version N vs N+1",
      "can_go_wrong": "TODO: for a requirements agent",
      "guard": "sample_pairs"
    }
  ],
  "rule_catalogue_file": "agent/rules.md",
