{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/rr/output/1.0.0",
  "title": "RequirementReviewer output",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "story_id": {
      "type": "string",
      "pattern": "^US-[0-9]{3}$"
    },
    "status": {
      "enum": [
        "ok",
        "needs_clarification"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    }
  },
  "required": [
    "contract_version",
    "story_id",
    "status",
    "findings",
    "open_questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3}-[0-9]{2}$"
        },
        "ac_id": {
          "type": "string",
          "pattern": "^AC[0-9]+$"
        },
        "category": {
          "enum": [
            "AMBIGUOUS",
            "UNMEASURABLE",
            "INCOMPLETE",
            "CONTRADICTION",
            "UNTESTABLE"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "explanation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "question": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "pattern": "\\?$"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "high = money, a blocked purchase or a contradiction; medium = a missing message, limit or actor; low = wording only"
        }
      },
      "required": [
        "id",
        "ac_id",
        "category",
        "quote",
        "explanation",
        "question",
        "severity"
      ],
      "additionalProperties": false
    }
  }
}