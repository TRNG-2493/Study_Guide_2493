{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/rr/input/1.0.0",
  "title": "RequirementReviewer input",
  "description": "One user story sent to the RequirementReviewer agent.",
  "type": "object",
  "properties": {
    "story_id": {"type": "string", "pattern": "^US-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^AC[0-9]+$"},
          "text": {"type": "string", "minLength": 5}
        },
        "required": ["id", "text"],
        "additionalProperties": false
      }
    },
    "max_findings": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10},
    "focus": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["AMBIGUOUS", "UNMEASURABLE", "INCOMPLETE", "CONTRADICTION", "UNTESTABLE"]},
      "default": ["AMBIGUOUS", "UNMEASURABLE", "INCOMPLETE", "CONTRADICTION", "UNTESTABLE"]
    }
  },
  "required": ["story_id", "title", "acceptance_criteria"],
  "additionalProperties": false
}
